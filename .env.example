# Copy this file to ".env" (same folder as main.py) and fill in your key.
# The app uses OpenRouter (openrouter.ai) instead of a paid API directly,
# so you can use free-tier models for personal/non-commercial use.
#
# 1. Create a free account at https://openrouter.ai
# 2. Create an API key at https://openrouter.ai/keys
# 3. Pick a model below (or browse https://openrouter.ai/models?max_price=0)

OPENROUTER_API_KEY=your_key_here

# meta-llama/llama-3.3-70b-instruct:free is recommended as the default:
# it's a plain instruct model (not a "reasoning" model), so it answers
# directly instead of spending its token budget "thinking" first — which
# is the #1 cause of empty/failed replies with free reasoning models on
# short, structured tasks like the Smart Grouped Export feature.
#
# NOTE: OpenRouter's free model catalog changes weekly (models get added
# and delisted). If this model stops working, check the current free
# list at https://openrouter.ai/models?max_price=0 and pick another
# non-reasoning "instruct" model. Use the "Test AI Connection" button in
# the AI Assistant screen to quickly verify a model works before relying
# on it for a real export.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
